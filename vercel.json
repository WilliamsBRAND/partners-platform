{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/p/:code/:slug", "destination": "/api/p?code=:code&slug=:slug" },
    { "source": "/p/:code", "destination": "/api/p?code=:code" },
    { "source": "/r/:code/:slug", "destination": "/api/p?code=:code&slug=:slug" },
    { "source": "/r/:code", "destination": "/api/p?code=:code" }
  ]
}
