# Copy this file to .env and fill in your real values. Never commit .env.

# Supabase (partner program database) - project pkdpaltivlcdwvvbkjbf
SUPABASE_URL=https://pkdpaltivlcdwvvbkjbf.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Base URL of this app (Partners). Used to build admin/links.
SITE_URL=https://partners.tomidewilliams.com

# Admin password for /admin
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

# Secret used to sign admin session tokens. Optional — falls back to ADMIN_PASSWORD if unset.
# Set a long random value distinct from the password for better security.
ADMIN_TOKEN_SECRET=YOUR_RANDOM_TOKEN_SECRET

# Google Apps Script webhook that emails withdrawal notifications to Tomide via Gmail.
# The script should read the JSON body and send an email to the 'to' field.
WITHDRAWAL_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
WITHDRAWAL_EMAIL=sodunketomide@gmail.com

# Secret used to sign partner session tokens. Optional — falls back to SUPABASE_SERVICE_KEY if unset.
# Set a long random value for better security.
PARTNER_TOKEN_SECRET=YOUR_RANDOM_PARTNER_TOKEN_SECRET
